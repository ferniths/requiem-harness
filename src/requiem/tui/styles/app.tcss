/* REQUIEM — shared application stylesheet.
 *
 * All semantic colors use $requiem-* CSS variables, which are resolved
 * from the active Palette at runtime via App.get_css_variables().
 * This keeps Rich-rendered objects and TCSS styles in sync.
 *
 * Surface hierarchy:
 *   $requiem-bg          — Obsidian (deepest)
 *   $requiem-bg-recessed — Dark Iron (panels, sidebar)
 *   $requiem-bg-elevated — Elevated Iron (hover, cards)
 *
 * Text hierarchy:
 *   $requiem-text         — Ash White (primary)
 *   $requiem-text-muted   — Muted Ash (secondary)
 *
 * Accents:
 *   $requiem-accent        — primary (Blood Crimson in Classic)
 *   $requiem-accent-deep   — secondary crimson
 *   $requiem-accent-alt    — rare premium (Antique Gold in Classic)
 */

/* ── Base ──────────────────────────────────────────────────────────────── */

Screen {
    background: $requiem-bg;
    color: $requiem-text;
}

/* ── Application shell ─────────────────────────────────────────────────── */

#req-header {
    height: 3;
    background: $requiem-bg-recessed;
    border-bottom: solid $requiem-border;
    padding: 0 2;
}

#req-header-title {
    color: $requiem-text;
    text-style: bold;
}

#req-header-subtitle {
    color: $requiem-text-muted;
    margin: 0 1;
}

#req-header-status {
    color: $requiem-accent;
    width: 1fr;
    text-align: right;
}

#req-nav-rail {
    width: 22;
    height: 1fr;
    background: $requiem-bg-recessed;
    border-right: solid $requiem-border;
    padding: 1 0;
}

#req-nav-item {
    height: 1;
    padding: 0 2;
    color: $requiem-text-muted;
}

#req-nav-item.active {
    color: $requiem-text;
    text-style: bold;
    background: $requiem-bg-elevated;
}

#req-nav-item.hover {
    color: $requiem-text;
}

#req-nav-group-label {
    color: $requiem-text-muted;
    text-style: italic;
    padding: 1 2 0 2;
    height: 1;
}


#req-workspace {
    height: 1fr;
    width: 1fr;
}

#req-status-bar {
    height: 1;
    background: $requiem-bg-recessed;
    border-top: solid $requiem-border;
    padding: 0 2;
    color: $requiem-text-muted;
}

#req-status-item {
    margin-right: 3;
}

#req-status-item.accent {
    color: $requiem-accent;
}

/* ── Section headers ───────────────────────────────────────────────────── */

.req-section-title {
    color: $requiem-text;
    text-style: bold;
    padding: 1 0 0 0;
    height: 1;
}

.req-section-rule {
    color: $requiem-border;
    height: 1;
}

/* ── Chat ───────────────────────────────────────────────────────────────── */

#req-chat-log {
    height: 1fr;
    overflow-y: auto;
    padding: 1 1;
}

.req-msg-user {
    color: $requiem-text;
    padding: 0 1;
    width: 100%;
}

.req-msg-user-label {
    color: $requiem-accent;
    text-style: bold;
}

.req-msg-assistant {
    color: $requiem-text;
    padding: 0 1;
    width: 100%;
}

.req-msg-assistant-label {
    color: $requiem-accent-alt;
    text-style: bold;
}

.req-msg-system {
    color: $requiem-text-muted;
    text-style: italic;
    padding: 0 1;
    width: 100%;
}

.req-msg-separator {
    color: $requiem-border;
    height: 1;
}

.req-tool-label {
    color: $requiem-accent;
    text-style: bold;
}

.req-tool-running {
    color: $requiem-accent-alt;
}

.req-tool-done {
    color: $requiem-success;
}

.req-tool-failed {
    color: $requiem-error;
}

/* ── Input composer ────────────────────────────────────────────────────── */

#req-composer {
    height: auto;
    min-height: 5;
    max-height: 12;
    background: $requiem-bg-recessed;
    border-top: solid $requiem-border;
    padding: 1 2;
}

#req-composer-input {
    height: 1;
    min-height: 1;
    max-height: 6;
    width: 100%;
    background: $requiem-bg-elevated;
    border: solid $requiem-border;
    padding: 0 1;
    color: $requiem-text;
}

#req-composer-input:focus {
    border: solid $requiem-accent;
}

#req-composer-hints {
    height: 1;
    color: $requiem-text-muted;
    margin-top: 1;
    text-align: right;
}

/* ── Empty states ──────────────────────────────────────────────────────── */

.req-empty-state {
    color: $requiem-text-muted;
    padding: 2;
    text-align: center;
}

.req-empty-state-title {
    color: $requiem-text;
    text-style: bold;
    text-align: center;
    padding-bottom: 1;
}

.req-empty-state-action {
    color: $requiem-accent;
    text-align: center;
    padding-top: 1;
}

/* ── List / table rows ─────────────────────────────────────────────────── */

.req-row {
    height: 1;
    padding: 0 1;
}

.req-row.selected {
    background: $requiem-bg-elevated;
    color: $requiem-text;
}

.req-row-header {
    color: $requiem-text-muted;
    text-style: bold;
    padding: 0 1;
}

/* ── Status indicators ─────────────────────────────────────────────────── */

.req-status-connected {
    color: $requiem-success;
}

.req-status-configured {
    color: $requiem-text-muted;
}

.req-status-error {
    color: $requiem-error;
}

.req-status-warn {
    color: $requiem-accent-alt;
}

.req-status-idle {
    color: $requiem-text-muted;
}

/* ── Buttons / interactive elements ────────────────────────────────────── */

.req-button {
    background: $requiem-bg-elevated;
    border: solid $requiem-border;
    padding: 0 2;
    color: $requiem-text;
}

.req-button:focus {
    border: solid $requiem-accent;
    color: $requiem-text;
}

.req-button.active {
    background: $requiem-bg-elevated;
    border: solid $requiem-accent;
    color: $requiem-accent;
}

/* ── Modals (reserved for dialogs only) ────────────────────────────────── */

.req-modal {
    background: $requiem-bg-recessed;
    border: solid $requiem-border;
    width: 60%;
    height: auto;
    max-height: 80%;
    padding: 1;
}

/* ── Command palette ───────────────────────────────────────────────────── */

#req-palette {
    background: $requiem-bg-recessed;
    border: solid $requiem-accent;
    width: 50%;
    height: auto;
    max-height: 50%;
    padding: 1;
}

#req-palette-input {
    height: 1;
    background: $requiem-bg-elevated;
    border: solid $requiem-border;
    padding: 0 1;
}

.req-palette-item {
    height: 1;
    padding: 0 2;
    color: $requiem-text-muted;
}

.req-palette-item.selected {
    background: $requiem-bg-elevated;
    color: $requiem-text;
}

.req-palette-key {
    color: $requiem-text-muted;
    margin-left: 1;
}

/* ── Settings ──────────────────────────────────────────────────────────── */

.req-setting-label {
    color: $requiem-text;
    padding: 1 0 0 1;
}

.req-setting-desc {
    color: $requiem-text-muted;
    padding: 0 0 1 2;
    height: 1;
}

.req-setting-control {
    height: 1;
    padding: 0 1;
}

/* ── Log viewer ────────────────────────────────────────────────────────── */

.req-log-row {
    height: 1;
    padding: 0 1;
}

.req-log-timestamp {
    color: $requiem-text-muted;
    width: 8;
}

.req-log-level {
    width: 7;
}

.req-log-level.DEBUG {
    color: $requiem-text-muted;
}

.req-log-level.INFO {
    color: $requiem-text;
}

.req-log-level.WARNING {
    color: $requiem-accent-alt;
}

.req-log-level.ERROR {
    color: $requiem-error;
}

.req-log-component {
    color: $requiem-text-muted;
    width: 14;
}

.req-log-message {
    color: $requiem-text;
    width: 1fr;
}

/* ── Theme swatches ────────────────────────────────────────────────────── */

.req-theme-swatch {
    height: 1;
    width: 3;
    margin-right: 1;
}

.req-theme-item {
    height: 1;
    padding: 0 1;
}

.req-theme-item.active {
    color: $requiem-accent;
    text-style: bold;
}
